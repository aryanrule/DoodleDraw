# ======================
# 🔹 Database
# ======================
MONGODB_URL=your_mongodb_connection_string_here

# ======================
# 🔹 API URLs
# ======================
# This will be available to frontend
NEXT_PUBLIC_API_URL=https://your-api-url.com

# ======================
# 🔹 Razorpay
# ======================
# ✅ Public key (safe for frontend)
NEXT_PUBLIC_RAZPAY_KEY_ID=rzp_test_yourpublickey

# 🔒 Private keys (backend only)
RAZPAY_KEY_ID=rzp_test_yourpublickey
RAZPAY_KEY_SECRET=your_secret_key

# ======================
# 🔹 Kinde Auth (if you use it)
# ======================
KINDE_CLIENT_ID=your_kinde_client_id
KINDE_CLIENT_SECRET=your_kinde_client_secret
KINDE_ISSUER_URL=your_kinde_issuer_url
KINDE_SITE_URL=your_kinde_site_url
KINDE_POST_LOGOUT_REDIRECT_URL=your_logout_redirect
KINDE_POST_LOGIN_REDIRECT_URL=your_login_redirect
  